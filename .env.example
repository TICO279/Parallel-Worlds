BOSON_API_KEY=
APPRAISAL_PROVIDER=mock
# For live DeepSeek, begin with 6000 ms and measure actual latency; 1500 is the mock/development default.
APPRAISAL_TIMEOUT_MS=1500
CHARACTER_MAX_STATE_DELTA=0.10
CHARACTER_MEMORY_CAPACITY=8
CHARACTER_MEMORY_TEXT_LIMIT=160
APPRAISAL_MAX_OUTPUT_TOKENS=1600
# Live defaults to subtle variation (0.35); mock defaults to deterministic (0).
# Explicit 0 makes policy selection steady; 0..1 controls variation among eligible choices.
CHARACTER_BEHAVIOR_VARIATION=
# Optional experiment seed, saved in exports. Never put an API credential here.
CHARACTER_BEHAVIOR_SEED=
# Empty selects deepseek-flash for DeepSeek, gpt-6-luna for OpenAI.
APPRAISAL_MODEL=
# Preferred initial live provider: APPRAISAL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Only enable both when the key below is explicitly intended for this project.
APPRAISAL_OPENAI_PROJECT_KEY=false
OPENAI_API_KEY=
