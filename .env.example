# Copy to .env and fill in. Never commit .env. Restart `pnpm dev` after changes.
# Required: Boson AI key for realtime sessions and text-to-speech.
BOSON_API_KEY=
# Recommended: DeepSeek key for judging each line, voice emotions and practice feedback.
# Without it, offline keyword rules are used and feedback is unavailable.
DEEPSEEK_API_KEY=

# Everything below is optional; the defaults are tested.
APPRAISAL_PROVIDER=mock
# For live DeepSeek, begin with 6000 ms and measure actual latency; 1500 is the mock/development default.
APPRAISAL_TIMEOUT_MS=1500
CHARACTER_MAX_STATE_DELTA=0.10
CHARACTER_MEMORY_CAPACITY=8
CHARACTER_MEMORY_TEXT_LIMIT=160
APPRAISAL_MAX_OUTPUT_TOKENS=1600
# Lines of the current trajectory (replayed branch + this session) sent with each appraisal. 2–400.
APPRAISAL_CONTEXT_LINES=60
# Quick check of every user line + the voice emotion per sentence.
# deepseek (default when DEEPSEEK_API_KEY is set) | jev (TypeSafe Jev via JEV_URL) | mock (keyword rules, no network).
DECISION_PROVIDER=
DECISION_MODEL=deepseek-flash
DECISION_TIMEOUT_MS=4000
# Any gateway exposing TypeSafe's decisions API, e.g. TokenRouter or OpenRouter (/api/alpha/decisions).
JEV_API_KEY=
JEV_URL=https://api.tokenrouter.com/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.14
# P(major shift) at or above this runs the full appraisal before the reply.
MAJOR_SHIFT_THRESHOLD=0.7
# major_shift: DeepSeek appraises only flagged lines. every_turn: the earlier asynchronous mode.
APPRAISAL_TRIGGER=major_shift
# Higgs TTS 3 speaks Higgs's text replies (uses BOSON_API_KEY).
TTS_MODEL=higgs-tts-3
# Voice for the built-in lab character; Ember partners use a voice matching their gender.
TTS_VOICE=default
TTS_TIMEOUT_MS=15000
# Empty selects deepseek-flash for DeepSeek, gpt-6-luna for OpenAI.
APPRAISAL_MODEL=
# Preferred live provider for full appraisal: APPRAISAL_PROVIDER=deepseek (uses DEEPSEEK_API_KEY above).
# Only enable both when the key below is explicitly intended for this project.
APPRAISAL_OPENAI_PROJECT_KEY=false
OPENAI_API_KEY=
